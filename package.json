{
  "name": "zenith-car-dealership",
  "version": "1.0.0",
  "description": "Full-stack car dealership platform",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
